{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/saiba-mais", "destination": "/laxante-v1", "permanent": true }
  ],
  "headers": [
    {
      "source": "/assets/img/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
